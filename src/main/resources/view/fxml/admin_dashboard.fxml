<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.romanimazione.controller.graphic.JavaFXAdminDashboardController"
            prefHeight="600.0" prefWidth="900.0">

    <top>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="header-panel">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <Label fx:id="welcomeLabel" text="Welcome, Admin" styleClass="label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="button-cancel"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="30.0" alignment="CENTER">
            <VBox alignment="CENTER" spacing="5.0">
                <Label text="Admin Dashboard" styleClass="label-header"/>
                <Label text="Benvenuto nel pannello di gestione. Seleziona un'operazione per iniziare." styleClass="label-subtitle"/>
            </VBox>
            
            <VBox alignment="CENTER" spacing="30">
                <HBox alignment="CENTER" spacing="30">
                    <Button text="Create New Party" onAction="#handleCreateParty" prefWidth="250" prefHeight="150" styleClass="button-primary" contentDisplay="TOP">
                        <graphic>
                            <ImageView fitHeight="64" fitWidth="64" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@../../images/create_party_icon.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button text="List All Parties" onAction="#handleListParties" prefWidth="250" prefHeight="150" styleClass="button-primary" contentDisplay="TOP">
                        <graphic>
                            <ImageView fitHeight="64" fitWidth="64" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@../../images/list_parties_icon.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="btnManageEquipment" text="Manage Equipment" onAction="#handleManageEquipment" prefWidth="250" prefHeight="150" styleClass="button-primary" contentDisplay="TOP">
                        <graphic>
                            <ImageView fitHeight="64" fitWidth="64" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@../../images/equipment_icon.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
                <HBox alignment="CENTER" spacing="30">
                    <Button fx:id="btnManageUsers" text="Manage Users" onAction="#handleManageUsers" prefWidth="250" prefHeight="150" visible="false" managed="false" styleClass="button-primary" contentDisplay="TOP">
                        <graphic>
                            <ImageView fitHeight="64" fitWidth="64" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@../../images/manage_users_icon.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="btnChangeMasterCode" text="Change Master Code" onAction="#handleChangeMasterCode" prefWidth="250" prefHeight="150" visible="false" managed="false" styleClass="button-primary" contentDisplay="TOP">
                        <graphic>
                            <ImageView fitHeight="64" fitWidth="64" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@../../images/mastercode_icon.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>
