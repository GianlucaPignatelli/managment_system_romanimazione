<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.romanimazione.controller.graphic.JavaFXAnimatorDashboardController"
            prefHeight="480.0" prefWidth="640.0">

    <top>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="header-panel">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <Label fx:id="welcomeLabel" text="Welcome, Animator" styleClass="label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="button-cancel"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="30.0" alignment="CENTER">
            <VBox alignment="CENTER" spacing="5.0">
                <Label text="Animator Dashboard" styleClass="label-header"/>
                <Label text="Benvenuto nel pannello animatori. Clicca su un'operazione per gestire i tuoi incarichi." styleClass="label-subtitle"/>
            </VBox>
            
            <HBox spacing="20.0" alignment="CENTER">
                <Button text="Manage Availability" onAction="#goToAvailability" prefWidth="220" prefHeight="120" styleClass="button-primary" contentDisplay="TOP">
                    <graphic>
                        <ImageView fitHeight="48" fitWidth="48" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../../images/manage_availability_icon.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button text="Job Offers" onAction="#goToJobOffers" prefWidth="220" prefHeight="120" styleClass="button-primary" contentDisplay="TOP">
                    <graphic>
                        <ImageView fitHeight="48" fitWidth="48" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../../images/job_offers_icon.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </center>

</BorderPane>
