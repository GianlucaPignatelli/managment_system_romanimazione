<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.romanimazione.controller.graphic.JavaFXAcceptedJobsController"
            stylesheets="@../../css/style.css, @../../styles/main.css"
            styleClass="main-background">

    <!-- Top Header -->
    <top>
        <VBox alignment="CENTER" spacing="10.0" styleClass="header-panel">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <Label text="Accepted Jobs" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="View and filter your confirmed work schedule." style="-fx-text-fill: #a0aabf;"/>
        </VBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            
            <!-- Filter Section -->
            <HBox spacing="15.0" alignment="CENTER_LEFT" styleClass="action-bar" style="-fx-padding: 15; -fx-background-color: #1e243b; -fx-background-radius: 8;">
                <Label text="Start Date:" style="-fx-text-fill: white;"/>
                <DatePicker fx:id="startDatePicker" prefWidth="150" promptText="From"/>
                
                <Label text="End Date:" style="-fx-text-fill: white;"/>
                <DatePicker fx:id="endDatePicker" prefWidth="150" promptText="To"/>
                
                <Button text="Filter" onAction="#handleFilter" styleClass="button-primary"/>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>
            
            <!-- Table Section -->
            <TableView fx:id="jobsTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="100"/>
                    <TableColumn fx:id="timeColumn" text="Time" prefWidth="120"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="120"/>
                    <TableColumn fx:id="cityColumn" text="Address/City" prefWidth="200"/>
                    <TableColumn fx:id="feeColumn" text="Total Fee (€)" prefWidth="100"/>
                </columns>
                <placeholder>
                    <Label text="No accepted jobs found for the selected period."/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

    <!-- Bottom Actions -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding>
                <Insets top="10.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <Button text="Back to Dashboard" onAction="#handleBack" styleClass="button-secondary"/>
        </HBox>
    </bottom>

</BorderPane>
