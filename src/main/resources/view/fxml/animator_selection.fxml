<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.romanimazione.controller.graphic.JavaFXAnimatorSelectionController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <VBox spacing="10" alignment="CENTER_LEFT">
             <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
             <Label text="Assign Animator to Party">
                 <font><Font name="System Bold" size="18.0"/></font>
             </Label>
             <Label fx:id="partyDetailsLabel" text="Party Details...">
                 <font><Font size="14.0"/></font>
             </Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
            
            <Label text="Current Assignments:" style="-fx-font-weight: bold"/>
            <TableView fx:id="currentAssignmentsTable" prefHeight="150">
                <columns>
                     <TableColumn fx:id="currentUsernameColumn" text="Username" prefWidth="150"/>
                     <TableColumn fx:id="currentStatusColumn" text="Status" prefWidth="150"/>
                     <TableColumn fx:id="currentActionColumn" text="Action" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            
            <Separator />
            
            <Label text="Available Animators (Select to Invite):" style="-fx-font-weight: bold"/>
            <TableView fx:id="animatorTable" prefHeight="200">
                <columns>
                    <TableColumn text="Username" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="username"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Name" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="nome"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Surname" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="cognome"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Email" prefWidth="180">
                        <cellValueFactory><PropertyValueFactory property="email"/></cellValueFactory>
                    </TableColumn>
                </columns>
                 <columnResizePolicy>
                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                 </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <Button text="Cancel" onAction="#handleCancel"/>
            <Button text="Confirm Assignment" onAction="#handleConfirm" defaultButton="true"/>
        </HBox>
    </bottom>

</BorderPane>
